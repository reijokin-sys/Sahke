[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name=Sähke
Comment=Sähköpostisovellus Ubuntu Touchille
Exec=qmlscene %U qml/Main.qml
Icon=assets/sahkoposti.png
X-Ubuntu-Touch=true
# The blue-black theme's background, because blue-black is the default. The
# theme choice is known only to the app, not to the shell that draws the
# splash window.
X-Ubuntu-Splash-Color=#000000
